{
  "schema_version": 1,
  "project_name": "Project Dynamo",
  "state_file": ".website-brochure-state.json",
  "website": {
    "source_globs": [
      "app/portfolio/project-dynamo/**/*.tsx",
      "components/image-lightbox.tsx"
    ],
    "url": "https://www.cognisint.com/portfolio/project-dynamo"
  },
  "brochure": {
    "source_globs": [],
    "output": "public/projects/project-dynamo/project-dynamo-auto-show-brochure.pdf",
    "build_command": null
  },
  "shared": {
    "source_globs": [],
    "asset_globs": [
      "public/projects/project-dynamo/*.png"
    ],
    "required_phrases": [
      {
        "text": "Project Dynamo",
        "in": [
          "website",
          "brochure"
        ]
      },
      {
        "text": "Not every vehicle needs to be shaped like an expensive basketball shoe.",
        "in": [
          "website"
        ]
      },
      {
        "text": "Available as a Petro-Electric vehicle (PEV) series hybrid or battery-electric (BEV)",
        "in": [
          "website"
        ]
      }
    ]
  }
}
